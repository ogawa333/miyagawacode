{
  "name": "三浦市ウォーキングラリー",
  "image": "mcr.microsoft.com/devcontainers/base:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.22.2"
    }
  },
  "remoteUser": "vscode",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "三浦市ウォーキングラリー",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm ci && npm run demo:seed"
}
